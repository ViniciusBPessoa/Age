# Age — variáveis de ambiente
#
# Copie para .env e gere segredos reais:
#   make env
#
# Nenhuma destas tem default no Compose: o serviço falha ao subir se
# faltar, em vez de rodar com MASTER_KEY vazia e só descobrir quando a
# primeira credencial for cifrada (ARQUITETURA.md §11.1).

# --- Postgres ---
# Superusuário do container (cria as roles na primeira subida).
POSTGRES_PASSWORD=troque-me

# Dono dos schemas. Roda as MIGRATIONS, nunca o runtime.
AGE_OWNER_PASSWORD=troque-me

# Roles de runtime: NOBYPASSRLS, não são donas de nada (§4.2.1).
CORE_API_DB_PASSWORD=troque-me
AI_WORKER_DB_PASSWORD=troque-me

# --- Redis ---
# Obrigatória: quem alcança o Redis injeta job arbitrário (§4.1.1).
REDIS_PASSWORD=troque-me

# --- Segredos de aplicação (mínimo 32 caracteres) ---
# Deriva as chaves que cifram credenciais de LLM e tokens OAuth (§4.3).
# PERDER ESTA CHAVE = perder todas as credenciais salvas.
MASTER_KEY=troque-me-por-32-caracteres-ou-mais

# Assina os JWT de usuário (§4.1.1).
JWT_SIGNING_KEY=troque-me-por-32-caracteres-ou-mais

# Autentica core-api -> ai-worker (§2.3.1).
SERVICE_JWT_SECRET=troque-me-por-32-caracteres-ou-mais

# --- URLs ---
# Base pública, usada como redirect_uri de OAuth (§4.1.3).
PUBLIC_BASE_URL=http://localhost:3000

# --- Rate limit (§2219, §9.1) ---
# Os valores de produção são os defaults de `config.py`; as variáveis
# abaixo existem só para sobrepô-los por ambiente. O formato é
# "vezes/segundos".
#
# Deixar ligado: sem rate limit, o login aceita tentativas de senha sem
# limite e as rotas de LLM podem ser chamadas em laço, gastando a cota
# da chave de API do usuário.
#RATE_LIMIT_ENABLED=true
#
# Os limites por IP são os que mais incomodam em desenvolvimento, porque
# todo container compartilha o IP do gateway do Compose. Os smokes
# zeram as chaves `rl:*:ip:*` no início em vez de desligar o limite.
#RATE_LIMIT_LOGIN_PER_IP=20/900
#RATE_LIMIT_REGISTER_PER_IP=20/3600

# --- Chave de LLM da instância (§3451) ---
# OPCIONAL. Preenchida, o Age funciona sem que o usuário precise criar
# conta num provedor de LLM: ele cria a conta, manda mensagem e pronto.
# O custo passa a ser seu, e é por isso que existe cota por usuário.
#
# Vazia, o comportamento é o anterior: cada pessoa cola a própria chave
# no onboarding ou em Configurações → Modelos.
#
# Precedência: quem COLOU a própria chave usa a dele (e sem cota, porque
# paga). Quem não colou usa esta, até a cota do mês.
#INSTANCE_LLM_API_KEY=sk-...
#INSTANCE_LLM_PROVIDER=deepseek
# Vazio = o default do adaptador do provedor.
#INSTANCE_LLM_MODEL=
#INSTANCE_LLM_BASE_URL=

# Cota mensal padrão, em USD, para contas que usam a chave da instância.
# É aplicada a contas NOVAS; a de cada usuário vive em
# `core.users.monthly_quota_usd` e pode ser mudada por conta — é o que
# torna um plano pago, no futuro, uma mudança de dado em vez de uma
# mudança de código. Vazio ou 0 = ilimitado.
#DEFAULT_MONTHLY_QUOTA_USD=2.00
