# Age — core-api
# Multi-stage: dependências em camada separada do código, para que
# mudar um arquivo .py não reinstale tudo.
# Contexto de build é a RAIZ do monorepo (precisa de packages/).

FROM python:3.12-slim AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app
RUN pip install --no-cache-dir uv==0.5.11 \
 && adduser --system --no-create-home --group age

# ---------------------------------------------------------------
FROM base AS deps
# O pacote compartilhado vem primeiro: é referenciado pelo pyproject.
COPY packages/age-contracts /packages/age-contracts
COPY services/core-api/pyproject.toml ./
RUN uv pip install --system --no-cache -e /packages/age-contracts \
 && uv pip install --system --no-cache \
      "fastapi>=0.115" "uvicorn[standard]>=0.32" "pydantic>=2.9" \
      "pydantic-settings>=2.6" "sqlalchemy[asyncio]>=2.0.36" \
      "asyncpg>=0.30" "alembic>=1.14" "redis>=5.2" "arq>=0.26" \
      "sse-starlette>=2.1" "argon2-cffi>=23.1" "pyjwt>=2.10" \
      "cryptography>=44.0" "email-validator>=2.2"       "python-dateutil>=2.9"

# ---------------------------------------------------------------
FROM deps AS dev
RUN uv pip install --system --no-cache \
      "pytest>=8.3" "pytest-asyncio>=0.24" "httpx>=0.28" "ruff>=0.8" \
      "hypothesis>=6.120"
COPY services/core-api/ .
USER age
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# ---------------------------------------------------------------
FROM deps AS prod
COPY services/core-api/ .
USER age
EXPOSE 8000
# 2 workers: suficiente para a escala do projeto, e mantém o uso de
# memória previsível (§2.3).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
