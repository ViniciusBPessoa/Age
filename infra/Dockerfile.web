# Age — web (Next.js 15, App Router)
# Contexto de build é a raiz do monorepo.

FROM node:22-alpine AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------
FROM base AS deps
# O lockfile VAI junto, e `npm ci` em vez de `npm install`.
#
# Sem ele, o npm resolvia as versões de novo dentro do container e
# escolhia as mais recentes que o `package.json` permite: pegava
# `vite@7` (via `@vitejs/plugin-react`), que exige
# `@types/node >= 22.12`, enquanto o projeto fixa `22.10.1`. O build da
# imagem falhava com ERESOLVE — e o `age.ps1` caía no fallback "subindo
# com as imagens já construídas", então a falha passava como aviso e o
# container seguia em modo de desenvolvimento.
#
# Localmente, com o lockfile, `vite` é 6.4.4 e não há conflito nenhum.
# Ou seja: o conflito era do processo de build, não das dependências.
#
# `npm ci` instala exatamente o que o lock diz e falha se os dois
# arquivos divergirem — que é o comportamento desejado numa imagem.
COPY services/web/package.json services/web/package-lock.json ./
RUN npm ci --no-audit --no-fund

# ---------------------------------------------------------------
FROM deps AS dev
COPY services/web/ .
EXPOSE 3000
CMD ["npm", "run", "dev"]

# ---------------------------------------------------------------
FROM deps AS build
COPY services/web/ .
RUN npm run build

# ---------------------------------------------------------------
FROM base AS prod
ENV NODE_ENV=production
RUN addgroup -S age && adduser -S age -G age
# `output: "standalone"` no next.config.ts é o que permite copiar só
# isto, em vez de node_modules inteiro (ARQUITETURA.md §11.3).
COPY --from=build --chown=age:age /app/.next/standalone ./
COPY --from=build --chown=age:age /app/.next/static ./.next/static
COPY --from=build --chown=age:age /app/public ./public
USER age
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
