# Age — web (Next.js 15, App Router)
# Contexto de build é a raiz do monorepo.

FROM node:22-alpine AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------
FROM base AS deps
COPY services/web/package.json ./
RUN npm install --no-audit --no-fund

# ---------------------------------------------------------------
FROM deps AS dev
COPY services/web/ .
EXPOSE 3000
CMD ["npm", "run", "dev"]

# ---------------------------------------------------------------
FROM deps AS build
COPY services/web/ .
RUN npm run build

# ---------------------------------------------------------------
FROM base AS prod
ENV NODE_ENV=production
RUN addgroup -S age && adduser -S age -G age
# `output: "standalone"` no next.config.ts é o que permite copiar só
# isto, em vez de node_modules inteiro (ARQUITETURA.md §11.3).
COPY --from=build --chown=age:age /app/.next/standalone ./
COPY --from=build --chown=age:age /app/.next/static ./.next/static
COPY --from=build --chown=age:age /app/public ./public
USER age
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
